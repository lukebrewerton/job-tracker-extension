{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["firefox-webext-browser"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "tests/**/*.js"]
}
